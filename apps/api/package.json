{
  "name": "@circle/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/migrate.ts",
    "db:seed": "bun --env-file=../../.env src/seed.ts"
  },
  "dependencies": {
    "@circle/shared": "workspace:*",
    "@elysiajs/cors": "^1.4.0",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.44.0",
    "elysia": "^1.4.0",
    "jose": "^6.1.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.10.0",
    "bun-types": "^1.4.3",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.3"
  }
}
